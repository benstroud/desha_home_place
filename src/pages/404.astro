---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you're looking for can't be found.">
  <header class="page-head">
    <span class="eyebrow">404</span>
    <h1>That page isn't here</h1>
    <p>The link may be old, or the page may have moved. The house, however, is still at home.</p>
  </header>
  <p>
    <a class="btn btn-primary" href="/">Return to the front door <span aria-hidden="true">→</span></a>
  </p>
</BaseLayout>
