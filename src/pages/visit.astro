---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Visit"
  description="The Franklin Desha House is a private family home. Visits are by arrangement only."
>
  <header class="page-head">
    <span class="eyebrow">By arrangement</span>
    <h1>Visiting the House</h1>
    <p>
      The Franklin Desha House is a private family home in Desha, Independence County, Arkansas. We're
      glad to welcome guests — but visits are by arrangement only.
    </p>
  </header>

  <section class="section">
    <div class="callout callout-note">
      <p class="callout-label">Please note</p>
      <p>
        This is not a public attraction and there are no walk-in hours. The house is the family's home,
        and we ask that visitors come only when invited or arranged with the family.
      </p>
    </div>
    <article class="prose">
      <h2>What to expect on a visit</h2>
      <p>
        When you visit, you'll be welcomed into the house and shown the rooms. QR codes placed in each
        room open that room's story on this website — no app needed, just your phone's camera. A
        printable tour guide is also available if you'd prefer paper.
      </p>
      <h2>Arranging a visit</h2>
      <p>
        Please contact the family directly to arrange a visit.
      </p>
      <div class="callout callout-family">
        <p class="callout-label">Family note</p>
        <p>
          ▲ <em>Add your preferred contact method here</em> — an email address or other way for invited
          guests and family to reach you. You may prefer not to publish contact details on the public
          site at all; if so, delete this box.
        </p>
      </div>
      <h2>Directions</h2>
      <p>
        We don't publish directions here, out of respect for the family's privacy. Invited guests will
        receive directions from the family directly.
      </p>
    </article>
  </section>
</BaseLayout>
